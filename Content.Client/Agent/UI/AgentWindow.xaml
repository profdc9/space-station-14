<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
               Title="{Loc 'agent-window-title'}"
               MinSize="260 300"
               SetSize="340 480">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <RichTextLabel Name="StatusLabel" Margin="4 4" />
        <cc:HSeparator />
        <OutputPanel Name="ConversationOutput" VerticalExpand="True" Margin="4 4" />
        <HistoryLineEdit Name="InputEdit" Margin="4 2" PlaceHolder="{Loc 'agent-input-placeholder'}" />
        <cc:HSeparator />
        <Label Name="NotificationHeader" Text="{Loc 'agent-notifications-header'}" Margin="4 4 4 0" />
        <OutputPanel Name="NotificationOutput" MinHeight="110" Margin="4 4" />
    </BoxContainer>
</DefaultWindow>
